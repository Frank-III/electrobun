{
  "name": "onecode-again",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "clean:build": "bun scripts/clean-build.ts",
    "ui:build": "bun scripts/build-ui.ts",
    "ui:build:prod": "bun scripts/build-ui.ts --minify",
    "typecheck": "bunx tsc -p tsconfig.typecheck.json",
    "build": "bun run clean:build && bun run ui:build && electrobun build",
    "build:prod": "bun run clean:build && bun run ui:build:prod && electrobun build --env=stable",
    "dev": "bun run build && electrobun dev",
    "start": "bun run dev",
    "test": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.2.32",
    "@kobalte/core": "^0.13.11",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@parcel/watcher": "^2.5.6",
    "@pierre/diffs": "^1.0.10",
    "@solid-primitives/keyboard": "^1.3.3",
    "@solid-primitives/map": "^0.7.2",
    "@solid-primitives/resize-observer": "^2.1.3",
    "@solid-primitives/scheduled": "^1.5.2",
    "@solid-primitives/set": "^0.7.2",
    "@solid-primitives/storage": "^4.3.3",
    "@tanstack/solid-query": "^5.90.23",
    "@tanstack/solid-virtual": "^3.13.18",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "ai": "^6.0.72",
    "bun-plugin-solid-oxc": "https://pkg.pr.new/Frank-III/solid-jsx-oxc/bun-plugin-solid-oxc@0bd4c89",
    "class-variance-authority": "^0.7.1",
    "drizzle-orm": "^0.45.1",
    "electrobun": "file:../../package",
    "lucide-solid": "^0.563.0",
    "mermaid": "^11.12.2",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^3.22.0",
    "solid-js": "^1.9.11",
    "solid-jsx-oxc": "https://pkg.pr.new/Frank-III/solid-jsx-oxc@0bd4c89",
    "solid-motionone": "^1.0.4",
    "solid-sonner": "^0.2.8",
    "streamdown": "^2.1.0",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.4.0",
    "xterm": "^5.3.0"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "bun-plugin-tailwind": "^0.0.13",
    "bun-types": "^1.3.8",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite-plugin-solid-oxc": "^0.1.0-alpha.15",
    "vitest": "^3.2.4"
  }
}
