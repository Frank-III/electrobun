{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["bun-types"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/mainview/*"],
      "@bun/*": ["src/bun/*"],
      "electrobun/view": ["src/types/electrobun.d.ts"],
      "electrobun/bun": ["src/types/electrobun.d.ts"]
    },
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src", "scripts"]
}
